
import { Router } from "express";
import { z } from "zod";
import { prisma } from "../../lib/prisma";
import { comparePassword, signAuthToken } from "../../lib/auth";

const router = Router();

const LoginSchema = z.object({
  email: z.string().email(),
  password: z.string().min(1),
  expectedUserType: z
    .enum(["internal", "customer_portal", "carrier_portal", "driver_app"])
    .optional(),
});

/**
 * POST /api/auth/login
 * Único endpoint de login para las 4 apps — el contrato ya lo asumían
 * los 4 frontends (`api/auth.ts` de cada app envía email+password, y
 * customer-portal/carrier-portal envían además `expectedUserType` para
 * evitar que alguien con credenciales internas entre por el portal
 * equivocado). Si `expectedUserType` viene y no coincide con el usuario
 * real, se rechaza — aunque la contraseña sea correcta.
 */
router.post("/login", async (req, res, next) => {
  try {
    const { email, password, expectedUserType } = LoginSchema.parse(req.body);

    const user = await prisma.appUser.findUnique({ where: { email } });

    if (!user || !user.active) {
      return res.status(401).json({ error: "invalid_credentials" });
    }

    const passwordOk = await comparePassword(password, user.passwordHash);
    if (!passwordOk) {
      return res.status(401).json({ error: "invalid_credentials" });
    }

    if (expectedUserType && user.userType !== expectedUserType) {
      return res.status(403).json({ error: "wrong_portal_for_user_type" });
    }

    const token = signAuthToken({
      userId: user.id,
      companyId: user.companyId,
      userType: user.userType,
      carrierId: user.carrierId ?? undefined,
      driverId: user.driverId ?? undefined,
      customerId: user.customerId ?? undefined,
    });

    return res.status(200).json({
      token,
      user: {
        id: user.id,
        email: user.email,
        fullName: user.fullName,
        userType: user.userType,
      },
    });
  } catch (err) {
    next(err);
  }
});

/**
 * GET /api/auth/me — para que cada frontend pueda validar el token al
 * cargar la app sin tener que decodificarlo en cliente.
 */
router.get("/me", async (req, res, next) => {
  try {
    const header = req.headers.authorization;
    if (!header?.startsWith("Bearer ")) return res.status(401).json({ error: "missing_token" });

    const { verifyAuthToken } = await import("../../lib/auth");
    const payload = verifyAuthToken(header.slice("Bearer ".length));

    const user = await prisma.appUser.findUnique({ where: { id: payload.userId } });
    if (!user || !user.active) return res.status(401).json({ error: "invalid_token" });

    return res.status(200).json({
      id: user.id,
      email: user.email,
      fullName: user.fullName,
      userType: user.userType,
      companyId: user.companyId,
    });
  } catch {
    return res.status(401).json({ error: "invalid_token" });
  }
});

export default router;
