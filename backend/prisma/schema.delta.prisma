enum ServiceSegment {
  paqueteria
  paleteria
  paleteria_pesada
  gran_volumen
}

model ServiceSegmentationRule {
  id                   String         @id @default(uuid())
  companyId            String
  company              Company        @relation(fields: [companyId], references: [id])
  segment              ServiceSegment
  maxWeightKg          Decimal?       @db.Decimal(12, 4)
  maxPallets           Decimal?       @db.Decimal(12, 4)
  maxWeightPerPalletKg Decimal?       @db.Decimal(12, 4)
  maxVolumeM3          Decimal?       @db.Decimal(12, 4)
  priority             Int
  active               Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([companyId, priority])
  @@map("service_segmentation_rule")
}

