// 13. Informes programados (17-kpis-bi-TMS.md: "posibilidad de programar
// envío periódico por email a un rol concreto")
// ----------------------------------------------------------------------------

model ScheduledReport {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  name            String
  metrics         String[]  // claves de METRICS (kpi.service.ts), validadas en la API antes de guardar
  dimensions      String[]  // claves de DIMENSIONS
  period          String?   // "day" | "week" | "month" | null
  filters         Json?     // { carrierId: "...", warehouseId: "..." }
  format          String    // "csv" | "xlsx" | "pdf"
  cronExpression  String    // ej. "0 8 * * MON" = cada lunes a las 8:00
  recipientEmails String[]
  active          Boolean   @default(true)
  lastSentAt      DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, active])
  @@map("scheduled_report")
}

// ----------------------------------------------------------------------------
// 14. Inteligencia — Predicción de ETA calibrada (16-inteligencia-artificial-TMS.md)
// ----------------------------------------------------------------------------

model RouteSpeedCalibration {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  carrierId    String
  carrier      Carrier  @relation(fields: [carrierId], references: [id])
  province     String
  hourBucket   Int      // 0-23, hora local de captura del tracking_event
  avgSpeedKmh  Decimal  @db.Decimal(6, 2)
  sampleSize   Int      // nº de tramos usados para calcular el promedio — informa la confianza del dato
  calculatedAt DateTime @default(now())

  @@unique([companyId, carrierId, province, hourBucket])
  @@index([companyId, carrierId, province])
  @@map("route_speed_calibration")
}

// ----------------------------------------------------------------------------
// 15. Inteligencia — Detección de anomalías (16-inteligencia-artificial-TMS.md)
// ----------------------------------------------------------------------------

enum AnomalyType {
  order_weight_deviation
  settlement_amount_deviation
  low_route_occupancy
  inefficient_route_distance
}

enum AnomalySeverity {
  low
  medium
  high
}

enum AnomalyStatus {
  pending
  reviewed
  dismissed
}

model AnomalyAlert {
  id           String          @id @default(uuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  alertType    AnomalyType
  severity     AnomalySeverity
  entityName   String          // "order" | "settlement_line" | "route" — mismo patrón que audit_log
  entityId     String
  description  String
  metricValue  Decimal?        @db.Decimal(12, 4) // valor observado, para mostrar en el detalle
  expectedRange String?        // texto auditable, ej. "120-340 kg (media ± 2 desviaciones)"
  status       AnomalyStatus   @default(pending)
  reviewedBy   String?
  reviewedAt   DateTime?
  detectedAt   DateTime        @default(now())

  // Evita duplicar la misma alerta para la misma entidad mientras siga
  // pendiente de revisión — ver anomaly-detection.service.ts.
  @@unique([companyId, alertType, entityId, status], name: "uq_pending_alert_per_entity")
  @@index([companyId, status, detectedAt])
  @@map("anomaly_alert")
}

// ----------------------------------------------------------------------------
// 16. Inteligencia — Predicción de demanda (16-inteligencia-artificial-TMS.md)
// ----------------------------------------------------------------------------
// Documento: "reutiliza el enfoque de percentiles ya presente en
// tms_getafe.html... evolucionado a un modelo real de series temporales"
// cuando el histórico lo justifique. Este modelo almacena el pronóstico
// YA CALCULADO (job nocturno) para que el Planificador lo consulte sin
// recomputar percentiles en cada carga de pantalla.

model DemandForecast {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  province         String
  forecastDate     DateTime @db.Date
  expectedOrdersP50 Decimal @db.Decimal(8, 2) // mediana histórica — estimación central
  expectedOrdersP80 Decimal @db.Decimal(8, 2) // percentil 80 — umbral de "necesitarás refuerzo de flota"
  expectedWeightKgP50 Decimal @db.Decimal(12, 2)
  expectedWeightKgP80 Decimal @db.Decimal(12, 2)
  sampleSize       Int      // nº de semanas históricas usadas para este día de la semana
  calculatedAt     DateTime @default(now())

  @@unique([companyId, warehouseId, province, forecastDate])
  @@index([companyId, warehouseId, forecastDate])
  @@map("demand_forecast")
}

