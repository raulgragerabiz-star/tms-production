model HolidayCalendar {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  date      DateTime @db.Date
  label     String
  province  String?  // NULL = festivo nacional, aplica a todas las provincias
  createdAt DateTime @default(now())

  @@unique([companyId, date, province])
  @@index([companyId, date])
  @@map("holiday_calendar")
}

model FuelIndexReading {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  effectiveOn DateTime @db.Date
  indexValue  Decimal  @db.Decimal(8, 4) // ej. €/litro gasóleo, referencia CORES/Boletín Petrolero
  source      String   @default("manual") // manual | cores_api (futuro)
  createdAt   DateTime @default(now())

  @@unique([companyId, effectiveOn])
  @@index([companyId, effectiveOn])
  @@map("fuel_index_reading")
}

// En `RateSurcharge` ya existente (Fase 3), el campo `value` se interpreta
// según `calculationMode` y `surchargeType`:
//   - fuel + percentage: % aplicado sobre el importe base de la tarifa,
//     multiplicado por el ratio (fuel_index actual / fuel_index de referencia
//     fijado en `baseline_value`, campo nuevo aditivo).
//   - adr + fixed|percentage: aplica solo si order.requiresAdr = true (campo
//     nuevo aditivo en Order, ver más abajo).
//   - holiday + percentage: aplica solo si route.routeDate está en
//     HolidayCalendar para la provincia del almacén/destino.
//   - waiting_time + per_hour: aplica sobre `shipment.waitingMinutes`
//     (campo nuevo aditivo en Shipment) por encima de una franquicia
//     (`franchiseMinutes`, campo nuevo aditivo en RateSurcharge).
//   - toll: importe real (`tollAmountOverride` en Route, si se conoce) o
//     estimado (`value` como importe fijo por defecto).
//
// Añadir a `RateSurcharge`:
//   baselineValue     Decimal? @db.Decimal(8, 4)  // para fuel: valor de referencia del índice
//   franchiseMinutes  Int?                          // para waiting_time: minutos gratuitos
//
// Añadir a `Order`:
//   requiresAdr Boolean @default(false)
//
// Añadir a `Shipment`:
//   waitingMinutes   Int?     // minutos de espera reales registrados en la parada/almacén
//   tollAmountActual Decimal? @db.Decimal(10, 2) // importe real de peaje si se conoce (telepeaje)

