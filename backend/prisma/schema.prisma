generator client {
  provider = "prisma-client-js"
  // node:20-alpine (Alpine 3.19+) trae OpenSSL 3.0, pero sin este binaryTargets
  // Prisma solo genera el motor "native" detectado en tiempo de build, que en
  // este caso quedo enlazado contra libssl.so.1.1 (OpenSSL 1.1.x) -- version que
  // el contenedor de runtime ya no tiene instalada. Resultado: el backend
  // arranca, pasa el probe TCP, y al primer intento de conectar a Prisma revienta
  // con "Error loading shared library libssl.so.1.1: No such file or directory"
  // y entra en crash-loop. Fijar explicitamente el target linux-musl-openssl-3.0.x
  // fuerza a generar (y descargar) el motor correcto para Alpine+OpenSSL3.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                      String                    @id @default(uuid())
  name                    String
  taxId                   String                    @unique @map("tax_id")
  active                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  users                   AppUser[]
  auditLogs               AuditLog[]
  carriers                Carrier[]
  customers               Customer[]
  orders                  Order[]
  products                Product[]
  roles                   Role[]
  routes                  Route[]
  ServiceSegmentationRule ServiceSegmentationRule[]
  warehouses              Warehouse[]
  HolidayCalendar         HolidayCalendar[]
  FuelIndexReading        FuelIndexReading[]
  anomalyAlerts           AnomalyAlert[]
  demandForecasts         DemandForecast[]
  // Fase 8: circuitos de reparto (agrupación de clientes por zona de
  // destino) -- ver modelo DeliveryZone más abajo.
  deliveryZones           DeliveryZone[]
  // Motor de inteligencia (3/3): auto-asignación de transportista cuando la
  // confianza del modelo de puntuación supera este umbral. Opt-in real --
  // `false` por defecto, nunca se activa sola; se gestiona desde la nueva
  // pantalla "Configuración". Ver auto-optimization.service.ts /
  // auto-optimization.orchestrator.ts.
  autoAssignEnabled       Boolean                   @default(false) @map("auto_assign_enabled")
  autoAssignMinConfidence Decimal                   @default(0.75) @map("auto_assign_min_confidence") @db.Decimal(3, 2)

  @@map("company")
}

// Festivos (Fase 9, motor de suplementos): un día es festivo para una provincia si
// hay una fila con esa provincia o una fila nacional (province = NULL) para esa
// fecha. Estaba documentado en schema.delta.prisma §9 (nunca mergeado en el schema
// real) y ya tiene seed de ejemplo en migrations_manual/v1_1_advanced_rates.sql,
// pero sin este modelo Prisma Client no conocía la tabla y el build de producción
// fallaba (`Property 'holidayCalendar' does not exist on type 'PrismaClient'`).
model HolidayCalendar {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])
  date      DateTime @db.Date
  label     String
  province  String? // NULL = festivo nacional, aplica a todas las provincias
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, date, province])
  @@index([companyId, date])
  @@map("holiday_calendar")
}

// Índice de combustible (Fase 9, suplemento "fuel"): mismo caso que HolidayCalendar
// — documentado en schema.delta.prisma §9 y con seed en
// migrations_manual/v1_1_advanced_rates.sql, pero nunca añadido al schema real.
model FuelIndexReading {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id])
  effectiveOn DateTime @map("effective_on") @db.Date
  indexValue  Decimal  @map("index_value") @db.Decimal(8, 4) // ej. €/litro gasóleo, referencia CORES/Boletín Petrolero
  source      String   @default("manual") // manual | cores_api (futuro)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([companyId, effectiveOn])
  @@index([companyId, effectiveOn])
  @@map("fuel_index_reading")
}

model Warehouse {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  name             String
  address          String?
  postalCode       String?  @map("postal_code")
  city             String?
  province         String?
  country          String   @default("ES")
  lat              Float?
  lng              Float?
  loadingHoursJson Json?    @map("loading_hours_json")
  isCrossDock      Boolean  @default(false) @map("is_cross_dock")
  externalCode     String?  @unique @map("external_code")
  layoutJson       Json?    @map("layout_json")
  // Fase 8k: jornada laboral máxima (horas) que se admite para una ruta que
  // sale de este almacén -- petición de Raúl tras ver una ruta de prueba
  // confirmada de 10:22 a 22:39 (más de 12h), que excede los límites reales
  // de jornada/tacógrafo. Opcional (null = sin límite propio, se usa el del
  // transportista si lo tiene -- ver Carrier.maxRouteDurationHours y la
  // validación en routes.routes.ts, PATCH /:id/status).
  maxRouteDurationHours Decimal? @map("max_route_duration_hours") @db.Decimal(4, 2)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  orders           Order[]
  routes           Route[]
  // Objetivo 2: franjas de km ("zona de influencia") desde este almacén,
  // cada una con su vehículo asignado -- relación nueva, no toca nada de lo
  // que ya había en Warehouse.
  influenceZones   InfluenceZone[]
  // Motor de inteligencia (2/3): pronósticos de demanda calculados para este
  // almacén (ver DemandForecast más abajo).
  demandForecasts  DemandForecast[]
  company          Company  @relation(fields: [companyId], references: [id])
  // Fase 8: circuitos de reparto que parten de este almacén (opcional --
  // un circuito puede no tener almacén asignado todavía).
  deliveryZones    DeliveryZone[]

  @@index([companyId, active])
  @@map("warehouse")
}

model AppUser {
  id           String     @id @default(uuid())
  companyId    String     @map("company_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  userType     UserType   @default(internal) @map("user_type")
  carrierId    String?    @map("carrier_id")
  customerId   String?    @map("customer_id")
  driverId     String?    @map("driver_id")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  company      Company    @relation(fields: [companyId], references: [id])
  roles        UserRole[]

  @@map("app_user")
}

model Role {
  id          String           @id @default(uuid())
  companyId   String?          @map("company_id")
  name        String
  code        String           @unique
  company     Company?         @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique
  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String  @map("user_id")
  roleId String  @map("role_id")
  role   Role    @relation(fields: [roleId], references: [id])
  user   AppUser @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
  @@map("user_role")
}

model AuditLog {
  id         String      @id @default(uuid())
  companyId  String?     @map("company_id")
  userId     String?     @map("user_id")
  entityName String      @map("entity_name")
  entityId   String      @map("entity_id")
  action     AuditAction
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  createdAt  DateTime    @default(now()) @map("created_at")
  company    Company?    @relation(fields: [companyId], references: [id])

  @@index([entityName, entityId, createdAt])
  @@map("audit_log")
}

model ProvinceCatalog {
  id          Int    @id @default(autoincrement())
  name        String @unique
  countryCode String @default("ES") @map("country_code")

  @@map("province_catalog")
}

model Customer {
  id             String          @id @default(uuid())
  companyId      String          @map("company_id")
  businessCode   String          @map("business_code")
  legalName      String          @map("legal_name")
  commercialName String?         @map("commercial_name")
  taxId          String?         @map("tax_id")
  // Dirección por defecto del cliente, cargada desde el maestro de
  // clientes/socios (ver customer-master-import.service.ts). El ERP exporta
  // el pedido con el código de cliente pero sin su dirección -- esa vive en
  // la ficha del socio dentro del propio ERP -- así que estos 4 campos
  // opcionales permiten resolver la dirección de entrega de un pedido por su
  // código de cliente cuando el Excel de pedidos no la trae. Totalmente
  // aditivo: nunca sustituye la dirección real de un pedido si el Excel de
  // pedidos ya la incluye.
  defaultAddress    String?       @map("default_address")
  defaultCity       String?       @map("default_city")
  defaultProvince   String?       @map("default_province")
  defaultPostalCode String?       @map("default_postal_code")
  // Fase 8: circuito de reparto al que pertenece este cliente (agrupación de
  // clientes por zona de destino, p.ej. "MAD1"/"ASTURIAS (Pinto)" -- ver
  // modelo DeliveryZone). Opcional y aditivo: un cliente sin circuito
  // asignado sigue funcionando exactamente igual que hasta ahora.
  deliveryZoneId String?         @map("delivery_zone_id")
  active         Boolean         @default(true)
  deletedAt      DateTime?       @map("deleted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  company        Company         @relation(fields: [companyId], references: [id])
  deliveryZone   DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id])
  customerRates  CustomerRate[]
  deliveryPoints DeliveryPoint[]
  orders         Order[]
  returnItems    ReturnItem[]

  @@unique([companyId, businessCode])
  @@index([deliveryZoneId])
  @@map("customer")
}

model DeliveryPoint {
  id               String    @id @default(uuid())
  customerId       String    @map("customer_id")
  label            String?
  address          String
  postalCode       String?   @map("postal_code")
  city             String?
  province         String?
  country          String    @default("ES")
  lat              Float?
  lng              Float?
  unloadHoursJson  Json?     @map("unload_hours_json")
  contactPhone     String?   @map("contact_phone")
  contactEmail     String?   @map("contact_email")
  exchangesPallets Boolean   @default(false) @map("exchanges_pallets")
  active           Boolean   @default(true)
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  customer         Customer  @relation(fields: [customerId], references: [id])
  orders           Order[]

  @@index([customerId])
  @@index([postalCode])
  @@map("delivery_point")
}

model Product {
  id                      String      @id @default(uuid())
  companyId               String      @map("company_id")
  sku                     String      @unique
  description             String
  salesUnit               String      @map("sales_unit")
  unitsPerPallet          Int         @map("units_per_pallet")
  grossWeightKg           Decimal     @map("gross_weight_kg") @db.Decimal(12, 4)
  netWeightKg             Decimal?    @map("net_weight_kg") @db.Decimal(12, 4)
  fullPalletWeightKg      Decimal     @map("full_pallet_weight_kg") @db.Decimal(12, 4)
  requiresCold            Boolean     @default(false) @map("requires_cold")
  isReturnable            Boolean     @default(true) @map("is_returnable")
  carriageNoteDescription String?     @map("carriage_note_description")
  // Objetivo 2: dimensiones del palé completo de este producto (misma
  // granularidad que fullPalletWeightKg), para poder calcular volumen real
  // ocupado por ruta y compararlo contra la capacidad del vehículo. Opcionales
  // para no romper los productos ya sembrados sin estos datos rellenos.
  lengthM                 Decimal?    @map("length_m") @db.Decimal(6, 2)
  widthM                  Decimal?    @map("width_m") @db.Decimal(6, 2)
  heightM                 Decimal?    @map("height_m") @db.Decimal(6, 2)
  // Referencias del catálogo real (importación SURTIDO GETAFE): categoría
  // (nomenclatura/familia), clasificación ABC de rotación y código de barras.
  // Todo opcional -- productos sin estos datos (o creados a mano) siguen
  // funcionando igual.
  category                String?     @map("category")
  abcClass                String?     @map("abc_class")
  ean                     String?     @map("ean")
  active                  Boolean     @default(true)
  deletedAt               DateTime?   @map("deleted_at")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")
  orderLines              OrderLine[]
  company                 Company     @relation(fields: [companyId], references: [id])

  @@map("product")
}

model Carrier {
  id                    String                @id @default(uuid())
  companyId             String                @map("company_id")
  legalName             String                @map("legal_name")
  taxId                 String                @unique @map("tax_id")
  city                  String?
  province              String?
  serviceType           CarrierServiceType    @default(both) @map("service_type")
  ownsFleet             Boolean               @default(false) @map("owns_fleet")
  temperatureCapability TemperatureCapability @default(ambient) @map("temperature_capability")
  notes                 String?
  // Fase 8k: jornada laboral máxima (horas) admitida para los conductores de
  // este transportista -- límite legal de conducción/tacógrafo. Opcional
  // (null = sin límite propio del transportista, se usa el del almacén si lo
  // tiene). Si ambos están configurados, se aplica el más restrictivo (ver
  // validación en routes.routes.ts, PATCH /:id/status).
  maxRouteDurationHours Decimal?              @map("max_route_duration_hours") @db.Decimal(4, 2)
  active                Boolean               @default(true)
  deletedAt             DateTime?             @map("deleted_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  company               Company               @relation(fields: [companyId], references: [id])
  settlements           CarrierSettlement[]
  costSimulations       CostSimulation[]
  customerRates         CustomerRate[]
  drivers               Driver[]
  fullTruckRates        FullTruckRate[]
  palletRates           PalletRate[]
  rateSurcharges        RateSurcharge[]
  routes                Route[]
  shipments             Shipment[]
  vehicles              Vehicle[]
  zoneRates             ZoneRate[]
  // Fase 8: tarifas por circuito de reparto que tiene contratadas este
  // transportista (ver DeliveryZoneRate) y tipos de vehículo que declara
  // poder aportar (checkboxes en "Flota y Transportistas" -- ver
  // CarrierVehicleType). Ambas aditivas, no sustituyen fullTruckRates/
  // palletRates/vehicles, que siguen funcionando igual.
  deliveryZoneRates     DeliveryZoneRate[]
  vehicleTypeOfferings  CarrierVehicleType[]

  @@map("carrier")
}

model VehicleType {
  id                     String           @id @default(uuid())
  name                   String
  maxWeightKg            Decimal          @map("max_weight_kg") @db.Decimal(12, 4)
  maxPallets             Int              @map("max_pallets")
  allowsExceedingPallets Boolean          @default(false) @map("allows_exceeding_pallets")
  // Objetivo 2: capacidad y dimensiones -- campos nuevos, opcionales para no
  // romper los tipos de vehículo ya sembrados (que no los tienen rellenos).
  maxVolumeM3            Decimal?         @map("max_volume_m3") @db.Decimal(12, 4)
  lengthM                Decimal?         @map("length_m") @db.Decimal(6, 2)
  widthM                 Decimal?         @map("width_m") @db.Decimal(6, 2)
  heightM                Decimal?         @map("height_m") @db.Decimal(6, 2)
  costSimulations        CostSimulation[]
  vehicles               Vehicle[]
  // Objetivo 2: tipo de vehículo asignado a una franja de zona de influencia.
  influenceZones         InfluenceZone[]
  // Fase 8: transportistas que declaran poder aportar este tipo de vehículo.
  carrierOfferings       CarrierVehicleType[]

  @@map("vehicle_type")
}

model Vehicle {
  id                 String                @id @default(uuid())
  carrierId          String                @map("carrier_id")
  vehicleTypeId      String                @map("vehicle_type_id")
  plate              String                @unique
  trailerPlate       String?               @map("trailer_plate")
  workingTemperature TemperatureCapability @default(ambient) @map("working_temperature")
  fuelType           String?               @map("fuel_type")
  itvExpiry          DateTime?             @map("itv_expiry")
  insuranceExpiry    DateTime?             @map("insurance_expiry")
  active             Boolean               @default(true)
  deletedAt          DateTime?             @map("deleted_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  routes             Route[]
  shipments          Shipment[]
  carrier            Carrier               @relation(fields: [carrierId], references: [id])
  vehicleType        VehicleType           @relation(fields: [vehicleTypeId], references: [id])
  driverAssignments  VehicleDriver[]
  // QR de identificación rápida (pegado físicamente al vehículo) y jornadas
  // de conductor iniciadas con este vehículo -- ver VehicleQrToken/DriverShift.
  qrTokens           VehicleQrToken[]
  shifts             DriverShift[]

  @@map("vehicle")
}

model Driver {
  id                 String          @id @default(uuid())
  carrierId          String          @map("carrier_id")
  fullName           String          @map("full_name")
  taxId              String          @unique @map("tax_id")
  phone              String?
  active             Boolean         @default(true)
  carrier            Carrier         @relation(fields: [carrierId], references: [id])
  shipments          Shipment[]
  vehicleAssignments VehicleDriver[]
  shifts             DriverShift[]

  @@map("driver")
}

// QR de identificación rápida del vehículo (pegado físicamente en la cabina):
// el conductor lo escanea desde la App para vincular ese vehículo concreto a
// su turno, sin depender de que backoffice le haya asignado uno fijo de
// antemano. `token` es el valor codificado en el QR físico; se revoca (no se
// borra) al regenerar, para no romper un QR ya impreso hasta que se sepa que
// el nuevo se ha repartido.
model VehicleQrToken {
  id        String    @id @default(uuid())
  vehicleId String    @map("vehicle_id")
  token     String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("vehicle_qr_token")
}

// Jornada del conductor (inicio/fin de turno), independiente de la fecha de
// ruta: un conductor puede iniciar jornada aunque su ruta del día aún no
// tenga vehículo asignado (queda con vehicleId nulo hasta que se vincula, por
// asignación de backoffice o escaneando el QR del vehículo). Como mucho una
// jornada abierta (endedAt nulo) por conductor a la vez -- lo valida el
// endpoint, no una constraint de base de datos, para poder dar un mensaje
// claro ("ya hay una jornada en curso") en vez de un error de integridad.
model DriverShift {
  id        String    @id @default(uuid())
  driverId  String    @map("driver_id")
  vehicleId String?   @map("vehicle_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  startLat  Float?    @map("start_lat")
  startLng  Float?    @map("start_lng")
  endLat    Float?    @map("end_lat")
  endLng    Float?    @map("end_lng")
  driver    Driver    @relation(fields: [driverId], references: [id])
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@index([driverId, startedAt])
  @@map("driver_shift")
}

model VehicleDriver {
  id        String    @id @default(uuid())
  vehicleId String    @map("vehicle_id")
  driverId  String    @map("driver_id")
  validFrom DateTime  @map("valid_from")
  validTo   DateTime? @map("valid_to")
  driver    Driver    @relation(fields: [driverId], references: [id])
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_driver")
}

model FullTruckRate {
  id           String    @id @default(uuid())
  carrierId    String    @map("carrier_id")
  validFrom    DateTime  @map("valid_from")
  validTo      DateTime? @map("valid_to")
  includedKm   Decimal   @map("included_km") @db.Decimal(12, 4)
  extraStopFee Decimal   @map("extra_stop_fee") @db.Decimal(12, 4)
  extraKmFee   Decimal   @map("extra_km_fee") @db.Decimal(12, 4)
  currency     String    @default("EUR") @db.Char(3)
  carrier      Carrier   @relation(fields: [carrierId], references: [id])

  @@index([carrierId])
  @@map("full_truck_rate")
}

model PalletRate {
  id                   String    @id @default(uuid())
  carrierId            String    @map("carrier_id")
  validFrom            DateTime  @map("valid_from")
  validTo              DateTime? @map("valid_to")
  fixedFeePerNote      Decimal   @map("fixed_fee_per_note") @db.Decimal(12, 4)
  looseItemFee         Decimal   @map("loose_item_fee") @db.Decimal(12, 4)
  maxWeightPerPalletKg Decimal   @map("max_weight_per_pallet_kg") @db.Decimal(12, 4)
  currency             String    @default("EUR") @db.Char(3)
  carrier              Carrier   @relation(fields: [carrierId], references: [id])

  @@index([carrierId])
  @@map("pallet_rate")
}

model RateSurcharge {
  id              String          @id @default(uuid())
  carrierId       String          @map("carrier_id")
  surchargeType   SurchargeType   @map("surcharge_type")
  calculationMode CalculationMode @map("calculation_mode")
  value           Decimal         @db.Decimal(12, 4)
  validFrom       DateTime        @map("valid_from")
  validTo         DateTime?       @map("valid_to")
  companyId       String          @map("company_id")
  carrier         Carrier         @relation(fields: [carrierId], references: [id])

  @@map("rate_surcharge")
}

model CustomerRate {
  id          String      @id @default(uuid())
  carrierId   String      @map("carrier_id")
  customerId  String      @map("customer_id")
  serviceType ServiceType @map("service_type")
  validFrom   DateTime    @map("valid_from")
  validTo     DateTime?   @map("valid_to")
  fixedAmount Decimal     @map("fixed_amount") @db.Decimal(12, 4)
  currency    String      @default("EUR") @db.Char(3)
  carrier     Carrier     @relation(fields: [carrierId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])

  @@map("customer_rate")
}

model ZoneRate {
  id          String      @id @default(uuid())
  carrierId   String      @map("carrier_id")
  serviceType ServiceType @map("service_type")
  zoneName    String      @map("zone_name")
  validFrom   DateTime    @map("valid_from")
  validTo     DateTime?   @map("valid_to")
  fixedAmount Decimal     @map("fixed_amount") @db.Decimal(12, 4)
  currency    String      @default("EUR") @db.Char(3)
  carrier     Carrier     @relation(fields: [carrierId], references: [id])

  @@map("zone_rate")
}

// Fase 8: "circuito" de reparto -- agrupación de clientes por zona de destino
// pedida por Raúl (plantilla real con columna "Rutas": "MAD1", "ASTURIAS
// (Pinto)", etc.), para poder ver y tarificar de un vistazo qué
// transportistas colaboran en cada circuito. Es un concepto DISTINTO de
// InfluenceZone (franjas de km desde un almacén que usa el auto-planificador
// para elegir tipo de vehículo -- ese modelo no se toca ni se sustituye) y
// también distinto del `zoneName` de texto libre de ZoneRate (tarifa por
// zona/provincia del motor de tarifas de Fase 9, sin relación a ninguna
// tabla). DeliveryZone es puramente organizativo/comercial: agrupa clientes
// y sirve de base a DeliveryZoneRate (la tarifa que cada transportista tiene
// pactada para ese circuito). Totalmente aditivo.
model DeliveryZone {
  id          String             @id @default(uuid())
  companyId   String             @map("company_id")
  warehouseId String?            @map("warehouse_id")
  name        String
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  company     Company            @relation(fields: [companyId], references: [id])
  warehouse   Warehouse?         @relation(fields: [warehouseId], references: [id])
  customers   Customer[]
  rates       DeliveryZoneRate[]

  @@unique([companyId, name])
  @@map("delivery_zone")
}

// Tarifa que un transportista concreto tiene pactada para un circuito
// concreto (puede haber varios transportistas por circuito, colaborando
// para destinos distintos dentro de él -- exactamente el caso "si se repiten
// por rutas es porque colaboran para diferentes destinos" que describió
// Raúl). Mismo patrón de vigencias que FullTruckRate/PalletRate
// (validFrom/validTo, sin solape -- validado en delivery-zones.routes.ts con
// la misma rangesOverlap() de siempre). Los 4 campos de importe replican
// las columnas de la plantilla real ("€", "€/Tn", "Descarga", "Ingreso
// €/tn socios"); todos opcionales porque no todas las filas de la plantilla
// traen los 4 rellenos.
model DeliveryZoneRate {
  id                  String       @id @default(uuid())
  deliveryZoneId      String       @map("delivery_zone_id")
  carrierId           String       @map("carrier_id")
  validFrom           DateTime     @map("valid_from")
  validTo             DateTime?    @map("valid_to")
  flatFee             Decimal?     @map("flat_fee") @db.Decimal(12, 4)
  pricePerTon         Decimal?     @map("price_per_ton") @db.Decimal(12, 4)
  unloadFee           Decimal?     @map("unload_fee") @db.Decimal(12, 4)
  partnerIncomePerTon Decimal?     @map("partner_income_per_ton") @db.Decimal(12, 4)
  scheduleNote        String?      @map("schedule_note")
  currency            String       @default("EUR") @db.Char(3)
  createdAt           DateTime     @default(now()) @map("created_at")
  deliveryZone        DeliveryZone @relation(fields: [deliveryZoneId], references: [id])
  carrier             Carrier      @relation(fields: [carrierId], references: [id])

  @@index([deliveryZoneId])
  @@index([carrierId])
  @@map("delivery_zone_rate")
}

// Capacidad declarada de un transportista: qué tipos de vehículo puede
// aportar (checkboxes en la fila de "Flota y Transportistas" > Transportistas
// que pidió Raúl). Es una simple tabla de relación muchos-a-muchos, no
// sustituye a Vehicle (que sigue siendo la matrícula real dada de alta) --
// esto es "este transportista PUEDE traer un frigorífico" antes incluso de
// tener uno matriculado en el sistema.
model CarrierVehicleType {
  id            String      @id @default(uuid())
  carrierId     String      @map("carrier_id")
  vehicleTypeId String      @map("vehicle_type_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  carrier       Carrier     @relation(fields: [carrierId], references: [id])
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@unique([carrierId, vehicleTypeId])
  @@map("carrier_vehicle_type")
}

model Order {
  id                     String            @id @default(uuid())
  companyId              String            @map("company_id")
  orderNumber            String            @unique @map("order_number")
  customerId             String            @map("customer_id")
  deliveryPointId        String            @map("delivery_point_id")
  warehouseId            String            @map("warehouse_id")
  status                 OrderStatus       @default(received)
  priority               OrderPriority     @default(standard)
  requestedDeliveryDate  DateTime          @map("requested_delivery_date")
  deliveryTimeWindowFrom String?           @map("delivery_time_window_from")
  deliveryTimeWindowTo   String?           @map("delivery_time_window_to")
  notes                  String?
  serviceType            ServiceType?      @map("service_type")
  externalSourceSystem   String?           @map("external_source_system")
  externalOrderId        String?           @map("external_order_id")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  invoices               CustomerInvoice[]
  company                Company           @relation(fields: [companyId], references: [id])
  customer               Customer          @relation(fields: [customerId], references: [id])
  deliveryPoint          DeliveryPoint     @relation(fields: [deliveryPointId], references: [id])
  warehouse              Warehouse         @relation(fields: [warehouseId], references: [id])
  documents              OrderDocument[]
  lines                  OrderLine[]
  routeStops             RouteStop[]
  // Objetivo 4 (Portal Cliente): valoración de satisfacción tras la entrega.
  // Relación 1-1 opcional -- un pedido sin entregar simplemente no tiene
  // fila asociada todavía, no rompe nada de lo ya existente.
  deliveryFeedback       DeliveryFeedback?

  @@index([companyId, status])
  @@index([deliveryPointId])
  @@index([requestedDeliveryDate])
  @@index([companyId, externalSourceSystem, externalOrderId])
  @@map("order")
}

model ServiceSegmentationRule {
  id                   String      @id @default(uuid())
  companyId            String      @map("company_id")
  segment              ServiceType
  maxWeightKg          Decimal?    @map("max_weight_kg") @db.Decimal(12, 4)
  maxPallets           Int?        @map("max_pallets")
  maxWeightPerPalletKg Decimal?    @map("max_weight_per_pallet_kg") @db.Decimal(12, 4)
  maxVolumeM3          Decimal?    @map("max_volume_m3") @db.Decimal(12, 4)
  priority             Int
  active               Boolean     @default(true)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  company              Company     @relation(fields: [companyId], references: [id])

  @@unique([companyId, segment])
  @@index([companyId, active, priority])
  @@map("service_segmentation_rule")
}

// Objetivo 2: "zona de influencia" -- franjas de distancia (km) desde un
// almacén concreto, cada una con el vehículo que se le asigna. Tabla nueva,
// no toca ninguna existente. weeklyShipments es solo informativo por ahora
// (referencia histórica que ve el planificador), no alimenta todavía ningún
// cálculo automático.
model InfluenceZone {
  id              String      @id @default(uuid())
  warehouseId     String      @map("warehouse_id")
  kmMin           Decimal     @map("km_min") @db.Decimal(10, 2)
  kmMax           Decimal     @map("km_max") @db.Decimal(10, 2)
  vehicleTypeId   String      @map("vehicle_type_id")
  weeklyShipments Decimal?    @map("weekly_shipments") @db.Decimal(10, 2)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  warehouse       Warehouse   @relation(fields: [warehouseId], references: [id])
  vehicleType     VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@index([warehouseId, kmMin])
  @@map("influence_zone")
}

model OrderLine {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  productId    String   @map("product_id")
  quantity     Decimal  @db.Decimal(12, 4)
  unit         String
  lineWeightKg Decimal? @map("line_weight_kg") @db.Decimal(12, 4)
  status       String   @default("ok")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_line")
}

model OrderDocument {
  id           String       @id @default(uuid())
  orderId      String       @map("order_id")
  documentType DocumentType @map("document_type")
  fileUrl      String       @map("file_url")
  createdAt    DateTime     @default(now()) @map("created_at")
  order        Order        @relation(fields: [orderId], references: [id])

  @@map("order_document")
}

model Route {
  id              String           @id @default(uuid())
  companyId       String           @map("company_id")
  warehouseId     String           @map("warehouse_id")
  routeDate       DateTime         @map("route_date")
  status          RouteStatus      @default(draft)
  serviceType     ServiceType      @map("service_type")
  carrierId       String?          @map("carrier_id")
  vehicleId       String?          @map("vehicle_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  costSimulations CostSimulation[]
  loadPlan        LoadPlan?
  carrier         Carrier?         @relation(fields: [carrierId], references: [id])
  company         Company          @relation(fields: [companyId], references: [id])
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  stops           RouteStop[]
  shipment        Shipment?
  // Motor de inteligencia — detección de rutas ineficientes (ver
  // anomaly-detection.service.ts): distancia planificada al secuenciar vs.
  // distancia real recorrida. Ambas opcionales -- no rompen filas
  // existentes ni exigen que ya estén pobladas para poder usar el resto de
  // Route con normalidad. Todavía sin alimentar automáticamente en ningún
  // sitio; el detector de anomalías simplemente no genera alertas de este
  // tipo hasta que haya datos.
  distancePlannedKm Decimal?       @map("distance_planned_km") @db.Decimal(10, 2)
  distanceRealKm    Decimal?       @map("distance_real_km") @db.Decimal(10, 2)

  @@map("route")
}

model RouteStop {
  id        String           @id @default(uuid())
  routeId   String           @map("route_id")
  orderId   String           @map("order_id")
  sequence  Int
  eta       DateTime?
  status    RouteStopStatus  @default(pending)
  incidents Incident[]
  pod       ProofOfDelivery?
  order     Order            @relation(fields: [orderId], references: [id])
  route     Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
  @@map("route_stop")
}

model LoadPlan {
  id                 String  @id @default(uuid())
  routeId            String  @unique @map("route_id")
  totalWeightKg      Decimal @default(0) @map("total_weight_kg") @db.Decimal(12, 4)
  totalPallets       Decimal @default(0) @map("total_pallets") @db.Decimal(12, 4)
  weightOccupancyPct Decimal @default(0) @map("weight_occupancy_pct") @db.Decimal(6, 4)
  palletOccupancyPct Decimal @default(0) @map("pallet_occupancy_pct") @db.Decimal(6, 4)
  // Objetivo 2: distancia/tiempo estimados de la ruta (almacén -> paradas en su
  // orden de secuencia). Nulos hasta que se recalcula la ruta (rutas ya
  // cerradas antes de este cambio simplemente no los tendrán, sin romper nada).
  distanceKm           Decimal? @map("distance_km") @db.Decimal(10, 2)
  estimatedDurationMin Int?     @map("estimated_duration_min")
  // Objetivo 2: volumen real ocupado (a partir de las dimensiones de palé de
  // cada producto) frente a la capacidad de volumen del vehículo asignado.
  // 0 mientras los productos de la ruta no tengan dimensiones cargadas.
  totalVolumeM3        Decimal  @default(0) @map("total_volume_m3") @db.Decimal(12, 4)
  volumeOccupancyPct   Decimal  @default(0) @map("volume_occupancy_pct") @db.Decimal(6, 4)
  route              Route   @relation(fields: [routeId], references: [id])

  @@map("load_plan")
}

model CostSimulation {
  id            String       @id @default(uuid())
  routeId       String       @map("route_id")
  carrierId     String       @map("carrier_id")
  vehicleTypeId String?      @map("vehicle_type_id")
  estimatedCost Decimal      @map("estimated_cost") @db.Decimal(12, 4)
  costBreakdown Json?        @map("cost_breakdown")
  isSelected    Boolean      @default(false) @map("is_selected")
  createdAt     DateTime     @default(now()) @map("created_at")
  carrier       Carrier      @relation(fields: [carrierId], references: [id])
  route         Route        @relation(fields: [routeId], references: [id])
  vehicleType   VehicleType? @relation(fields: [vehicleTypeId], references: [id])

  @@index([routeId, isSelected])
  @@map("cost_simulation")
}

model Shipment {
  id              String            @id @default(uuid())
  routeId         String            @unique @map("route_id")
  carrierId       String            @map("carrier_id")
  vehicleId       String            @map("vehicle_id")
  driverId        String?           @map("driver_id")
  status          ShipmentStatus    @default(programmed)
  departedAt      DateTime?         @map("departed_at")
  finishedAt      DateTime?         @map("finished_at")
  incidents       Incident[]
  returnClaims    ReturnClaim[]
  settlementLines SettlementLine[]
  carrier         Carrier           @relation(fields: [carrierId], references: [id])
  driver          Driver?           @relation(fields: [driverId], references: [id])
  route           Route             @relation(fields: [routeId], references: [id])
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id])
  messages        ShipmentMessage[]
  trackingEvents  TrackingEvent[]

  @@map("shipment")
}

model TrackingEvent {
  id         String            @id @default(uuid())
  shipmentId String            @map("shipment_id")
  eventType  TrackingEventType @map("event_type")
  lat        Float?
  lng        Float?
  payload    Json?
  occurredAt DateTime          @map("occurred_at")
  // Sincronización en tiempo real despacho<->conductor: id generado en el
  // dispositivo para los envíos por lote de la Driver App (offlineQueue.ts),
  // así un reintento tras perder cobertura no duplica el mismo ping ya
  // guardado. Opcional: los eventos ya existentes (gps-ping suelto, llegada
  // de parada, etc.) no lo llevan y siguen funcionando igual.
  clientEventId String?        @map("client_event_id")
  shipment   Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, clientEventId])
  @@index([shipmentId, occurredAt])
  @@map("tracking_event")
}

model Incident {
  id           String         @id @default(uuid())
  shipmentId   String         @map("shipment_id")
  routeStopId  String?        @map("route_stop_id")
  incidentType IncidentType   @map("incident_type")
  description  String?
  status       IncidentStatus @default(open)
  reportedBy   String?        @map("reported_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  routeStop    RouteStop?     @relation(fields: [routeStopId], references: [id])
  shipment     Shipment       @relation(fields: [shipmentId], references: [id])

  @@map("incident")
}

