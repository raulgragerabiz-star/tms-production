// ----------------------------------------------------------------------------
// Motor de inteligencia (1/3) — Detección de anomalías. Documentado en el
// delta v1.1 nunca fusionado (_manual_merge_needed/schema.delta.prisma §15)
// y ahora sí integrado: vigilancia de patrones fuera de lo habitual que
// genera una alerta para revisión humana -- nunca corrige nada
// automáticamente. Ver anomaly-detection.service.ts.
// ----------------------------------------------------------------------------
enum AnomalyType {
  order_weight_deviation
  settlement_amount_deviation
  low_route_occupancy
  inefficient_route_distance
}

enum AnomalySeverity {
  low
  medium
  high
}

enum AnomalyStatus {
  pending
  reviewed
  dismissed
}

model AnomalyAlert {
  id            String          @id @default(uuid())
  companyId     String          @map("company_id")
  company       Company         @relation(fields: [companyId], references: [id])
  alertType     AnomalyType     @map("alert_type")
  severity      AnomalySeverity
  entityName    String          @map("entity_name") // "order" | "settlement_line" | "carrier" -- mismo patrón que audit_log
  entityId      String          @map("entity_id")
  description   String
  metricValue   Decimal?        @map("metric_value") @db.Decimal(12, 4) // valor observado, para mostrar en el detalle
  expectedRange String?         @map("expected_range") // texto auditable, ej. "120-340 kg (media ± 2 desviaciones)"
  status        AnomalyStatus   @default(pending)
  reviewedBy    String?         @map("reviewed_by")
  reviewedAt    DateTime?       @map("reviewed_at")
  detectedAt    DateTime        @default(now()) @map("detected_at")

  // Evita duplicar la misma alerta para la misma entidad mientras siga
  // pendiente de revisión -- ver persistAlertIfNew() en el servicio.
  @@unique([companyId, alertType, entityId, status], name: "uq_pending_alert_per_entity")
  @@index([companyId, status, detectedAt])
  @@map("anomaly_alert")
}

// ----------------------------------------------------------------------------
// Motor de inteligencia (2/3) — Predicción de demanda. Documentado en el
// delta v1.1 nunca fusionado (_manual_merge_needed/.../schema.delta.prisma
// §16) y ahora integrado, adaptado al schema real (sin `$queryRaw`: se
// agrega en JS sobre una consulta Prisma normal, mismo criterio que
// dashboard.routes.ts y anomaly-detection.service.ts, para no depender de
// SQL a medida sin poder probarlo contra Postgres real desde este entorno).
// Guarda el pronóstico YA CALCULADO -- el Planificador (o esta pantalla) lo
// lee sin recomputar percentiles en cada carga. Sin job programado todavía
// (no hay infraestructura de tareas periódicas en el backend); se recalcula
// a mano con un botón, igual que la detección de anomalías (pieza 1/3).
model DemandForecast {
  id                  String   @id @default(uuid())
  companyId           String   @map("company_id")
  company             Company  @relation(fields: [companyId], references: [id])
  warehouseId         String   @map("warehouse_id")
  warehouse           Warehouse @relation(fields: [warehouseId], references: [id])
  province            String
  forecastDate        DateTime @map("forecast_date") @db.Date
  // Percentiles sobre el histórico del MISMO día de la semana en las últimas
  // 12 semanas -- P50 = mediana (estimación central), P80 = umbral de
  // "necesitarás refuerzo de flota" (se quiere estar preparado para el 80%
  // de los casos, no solo el mediano).
  expectedOrdersP50   Decimal  @map("expected_orders_p50") @db.Decimal(8, 2)
  expectedOrdersP80   Decimal  @map("expected_orders_p80") @db.Decimal(8, 2)
  expectedWeightKgP50 Decimal  @map("expected_weight_kg_p50") @db.Decimal(12, 2)
  expectedWeightKgP80 Decimal  @map("expected_weight_kg_p80") @db.Decimal(12, 2)
  sampleSize          Int      @map("sample_size") // nº de semanas históricas usadas para este día de la semana
  calculatedAt        DateTime @default(now()) @map("calculated_at")

  @@unique([companyId, warehouseId, province, forecastDate])
  @@index([companyId, warehouseId, forecastDate])
  @@map("demand_forecast")
}
